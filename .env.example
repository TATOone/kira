# Публичный адрес сайта
PUBLIC_SITE_URL=https://resurs-materinstva.ru

# Production: Keystatic пишет в GitHub (TATOone/kira)
PUBLIC_KEYSTATIC_STORAGE=github
PUBLIC_KEYSTATIC_GITHUB_REPO_OWNER=TATOone
PUBLIC_KEYSTATIC_GITHUB_REPO_NAME=kira

# Создаются при подключении GitHub App (см. README)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
